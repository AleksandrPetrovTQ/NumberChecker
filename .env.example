# Telegram bot token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Your Telegram chat id, from getUpdates after you message the bot.
TELEGRAM_CHAT_ID=

# Shared secret. Use the same long random value in Vercel and GitHub Actions.
CRON_SECRET=

# Optional. Production default is info. Use debug only while troubleshooting.
# LOG_LEVEL=info

# Optional. Checks allowed per IP per hour before Vodafone is called. Default 10.
# RATE_LIMIT_CHECK_PER_HOUR=10
